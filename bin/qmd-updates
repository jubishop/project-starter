#!/usr/bin/env python3
"""Check installed QMD and its resolved backend against current npm releases."""
import argparse
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.parse import quote
from urllib.request import urlopen


def version(value):
    match = re.fullmatch(r'(\d+)\.(\d+)\.(\d+)(?:[-+][0-9A-Za-z.-]+)?', str(value))
    if not match:
        raise ValueError('Invalid package version: ' + str(value))
    return tuple(map(int, match.groups()))


def read(path):
    return json.loads(path.read_text()) if path.exists() else {}


def write(path, value):
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        json.dump(value, stream, indent=2)
        stream.write('\n')
    try:
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--installation', type=Path, default=Path.home() / '.bun/install/global',
                        help='Package-manager root containing node_modules')
    parser.add_argument('--registry', default='https://registry.npmjs.org', help='npm registry URL')
    parser.add_argument('--state-file', type=Path, default=Path.home() / '.cache/qmd/updates.json')
    parser.add_argument('--notify', action='store_true', help='Notify on macOS when releases change or a check fails')
    args = parser.parse_args()
    args.state_file.parent.mkdir(parents=True, exist_ok=True)
    with args.state_file.with_suffix('.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        previous = read(args.state_file)
        report = {'checked_at': datetime.now(timezone.utc).isoformat(), 'status': 'current',
                  'installation': str(args.installation.resolve()), 'packages': [], 'updates': []}
        try:
            qmd = args.installation / 'node_modules/@tobilu/qmd'
            backend = qmd / 'node_modules/node-llama-cpp/package.json'
            if not backend.is_file():
                backend = args.installation / 'node_modules/node-llama-cpp/package.json'
            for name, path in (('@tobilu/qmd', qmd / 'package.json'), ('node-llama-cpp', backend)):
                installed = read(path).get('version')
                version(installed)
                url = args.registry.rstrip('/') + '/' + quote(name, safe='') + '/latest'
                with urlopen(url, timeout=15) as response:
                    payload = json.loads(response.read(65536))
                if payload.get('name') != name:
                    raise ValueError('Unexpected registry package: ' + name)
                latest = payload.get('version')
                available = version(latest) > version(installed)
                available |= version(latest) == version(installed) and '-' in installed and '-' not in latest
                item = {'name': name, 'installed': installed, 'latest': latest}
                report['packages'].append(item)
                if available:
                    report['updates'].append(item)
            if report['updates']:
                report['status'] = 'updates_available'
                message = '; '.join(p['name'] + ' ' + p['installed'] + ' → ' + p['latest'] for p in report['updates'])
                message += '. Run the Project Starter compatibility checks before upgrading.'
            else:
                message = ''
        except (OSError, ValueError, TypeError, KeyError) as error:
            report.update(status='failed', error=str(error))
            message = 'QMD update check failed: ' + str(error)
        report['message'] = message
        notification = previous.get('notified_message', '')
        if args.notify and message and message != notification:
            script = 'on run argv\n display notification (item 1 of argv) with title "QMD maintenance"\nend run\n'
            try:
                subprocess.run(['osascript', '-', message], input=script, text=True, check=True, capture_output=True)
                notification = message
            except (OSError, subprocess.SubprocessError) as error:
                report['notification_error'] = str(error)
                print('QMD notification failed: ' + str(error), file=sys.stderr)
        report['notified_message'] = notification if message else ''
        write(args.state_file, report)
        print(json.dumps(report, indent=2))
        return {'current': 0, 'updates_available': 2, 'failed': 1}[report['status']]


if __name__ == '__main__':
    sys.exit(main())

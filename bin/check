#!/usr/bin/env python3
"""Usage: bin/check [-h | --help]

Validate the guide, the bundle's documents, and this repository's skills, check Python syntax, shell scripts,
workflows, and whitespace, and run the tests, which exercise copies of the bundle, on the current platform. Outside
GitHub Actions, a change to the knowledge tools also runs bin/smoke-qmd with this machine's real QMD. The check has no
modes: it always runs everything.
"""
import ast
import os
from pathlib import Path
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / "starter/bin"))
from _checks import change_base, check_whitespace, skill_errors, validate
from _knowledge import git

# The knowledge module, the commands and hooks that load it, its collections, and the smoke check that runs them.
KNOWLEDGE_TOOLS = ("bin/smoke-qmd", "starter/.config/knowledge.json", "starter/bin",
                   ":(exclude)starter/bin/check", ":(exclude)starter/bin/_checks.py")


def knowledge_tools_changed():
    """Return whether this checkout's own changes, committed or not, touch the knowledge tools."""
    base = change_base(root)
    since = [base] if base else []
    return any(git(*command, "--", *KNOWLEDGE_TOOLS, root=root) for command in (
        ("diff", "--name-only", *since), ("diff", "--cached", "--name-only", *since),
        ("ls-files", "--others", "--exclude-standard")))


def main():
    if sys.argv[1:] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if sys.argv[1:]:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    errors = validate(root, areas=("docs",), options={"checks": {"exclude": ["starter/**", "extras/**"]}})
    errors += validate(root / "starter") + skill_errors(root)
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    for tool in ("shellcheck", "actionlint"):
        if not shutil.which(tool):
            print("Install " + tool + " before running bin/check.", file=sys.stderr)
            return 1
    for folder in (root / "bin", root / "tests", root / "starter/bin"):
        for path in folder.iterdir():
            if path.is_file() and (path.suffix == ".py" or path.read_bytes().startswith(b"#!/usr/bin/env python3")):
                ast.parse(path.read_text(), filename=str(path))
    if (root / "starter/.envrc").is_file():
        subprocess.run(["shellcheck", "--shell=bash", str(root / "starter/.envrc")], check=True)
    subprocess.run(["shellcheck", "--shell=sh", *map(str, sorted((root / "starter/bin/hooks").iterdir()))], check=True)
    workflows = sorted((root / ".github/workflows").glob("*.yml"))
    workflows += sorted((root / "extras/github/.github/workflows").glob("*.yml"))
    subprocess.run(["actionlint", *map(str, workflows)], cwd=root, check=True)
    subprocess.run([sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests", "-v"], cwd=root, check=True)
    check_whitespace(root)
    # Only the Mac runs real QMD; hosted runners test the knowledge tools with fakes. See docs/qmd-maintenance.md.
    if os.environ.get("GITHUB_ACTIONS") != "true" and knowledge_tools_changed():
        print("The knowledge tools changed, so bin/smoke-qmd checks them with this machine's QMD.", flush=True)
        subprocess.run([str(root / "bin/smoke-qmd"), "--strict-diagnostics"], check=True)
    print("Guide and copied-bundle checks passed on " + sys.platform + ".")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, SyntaxError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
